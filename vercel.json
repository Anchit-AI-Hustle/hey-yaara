{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "/download/android/?",
      "status": 302,
      "headers": {
        "Location": "https://github.com/Anchit-AI-Hustle/hey-yaara/releases/latest/download/hey-yaara.apk",
        "Cache-Control": "no-store"
      }
    },
    {
      "src": "/download/ios/?",
      "status": 302,
      "headers": {
        "Location": "https://github.com/Anchit-AI-Hustle/hey-yaara/releases/latest/download/hey-yaara-ios.ipa",
        "Cache-Control": "no-store"
      }
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/install/(.+)\\.mobileconfig",
      "headers": {
        "Content-Type": "application/x-apple-aspen-config",
        "Content-Disposition": "attachment; filename=\"hey-yaara.mobileconfig\"",
        "Cache-Control": "no-cache"
      },
      "continue": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
